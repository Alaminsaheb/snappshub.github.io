<!doctype html>
<html lang="en">
<head>
<link rel="canonical" href="https://alaminsaheb.github.io/snappshub.github.io/">
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#6ab344">
  <meta name="description" content="Apps, tools, and useful Android resources.">
  <title>SnappsHub — Apps & Tools</title>
  <style>
    :root{
      --green:#6ab344;--green-dark:#579c35;--ink:#222;--muted:#777;
      --line:#ececec;--paper:#fff;--page:#f6f7f6;--dark:#070707;
      --radius:7px;--shadow:0 2px 12px rgba(0,0,0,.045);
      --width:1100px
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0;background:var(--page);color:#555;font:15px/1.65 Lato,Arial,Helvetica,sans-serif}
    a{color:inherit;text-decoration:none}
    button,input{font:inherit}
    button,a,input{-webkit-tap-highlight-color:transparent}
    .topbar{background:var(--dark);color:#eee;font-size:12px}
    .top-inner,.wrap{width:min(var(--width),calc(100% - 32px));margin:auto}
    .top-inner{min-height:36px;display:flex;align-items:center;justify-content:space-between;gap:12px}
    .top-links,.socials{display:flex;align-items:center;gap:17px}
    .top-links a:hover,.socials a:hover{color:var(--green)}
    .socials a{display:inline-flex;align-items:center;justify-content:center;width:23px;height:23px;border:1px solid #444;border-radius:50%;font-size:10px;font-weight:700}
    .masthead{background:#fff;border-bottom:1px solid var(--line)}
    .brand-row{min-height:115px;display:flex;align-items:center;justify-content:space-between;gap:25px}
    .brand{display:flex;align-items:center;gap:13px;min-width:0}
    .brand-mark{width:54px;height:54px;border-radius:13px;background:var(--green);display:grid;place-items:center;color:#fff;font-size:29px;font-weight:800;box-shadow:inset 0 -4px rgba(0,0,0,.08)}
    .brand-name{margin:0;color:#222;font-size:29px;font-weight:800;letter-spacing:-1px;line-height:1.15}
    .brand-name span{color:var(--green)}
    .tagline{margin:5px 0 0;color:#888;font-size:12px}
    .header-search{display:flex;width:min(340px,45%);height:42px;border:1px solid #e7e7e7;border-radius:4px;overflow:hidden;background:#fff}
    .header-search input{width:100%;min-width:0;border:0;outline:0;padding:0 13px;color:#333;background:transparent}
    .header-search button{width:46px;flex:0 0 46px;border:0;background:var(--green);color:white;cursor:pointer;font-size:18px}
    .nav-wrap{background:var(--green);color:white;box-shadow:0 2px 5px #0000000a}
    .nav-inner{display:flex;align-items:stretch;justify-content:space-between;min-height:49px}
    .nav-links{display:flex;align-items:stretch;gap:0;flex-wrap:wrap}
    .nav-links a{display:flex;align-items:center;padding:0 17px;font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.35px}
    .nav-links a:hover,.nav-links a.active{background:var(--green-dark);color:#fff}
    .menu-toggle{display:none;background:transparent;border:0;color:white;font-size:24px;padding:7px 0;cursor:pointer}
    .page{display:grid;grid-template-columns:minmax(0,2fr) minmax(250px,1fr);gap:25px;padding-top:27px;padding-bottom:30px}
    .section-title{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:0 0 18px;padding:0 0 10px;border-bottom:2px solid var(--green);color:#222;font-size:16px;font-weight:800;text-transform:uppercase;letter-spacing:.3px}
    .section-title small{font-size:11px;color:#999;font-weight:500;text-transform:none;letter-spacing:0}
    .posts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
    .post{background:var(--paper);border:1px solid #ededed;border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow);transition:transform .18s,box-shadow .18s}
    .post:hover{transform:translateY(-3px);box-shadow:0 8px 24px rgba(0,0,0,.08)}
    .post-art{aspect-ratio:16/9;display:grid;place-items:center;position:relative;overflow:hidden;background:linear-gradient(135deg,#eef7e9,#d9edce)}
    .post-art:before,.post-art:after{content:"";position:absolute;border-radius:50%;background:#6ab34418}
    .post-art:before{width:180px;height:180px;right:-35px;top:-65px}
    .post-art:after{width:120px;height:120px;left:-38px;bottom:-58px}
    .app-icon{position:relative;z-index:1;width:78px;height:78px;display:grid;place-items:center;border-radius:21px;background:#fff;color:var(--green-dark);font-size:36px;font-weight:800;box-shadow:0 7px 24px #2e67221c}
    .post:nth-child(3n+2) .post-art{background:linear-gradient(135deg,#e8f3fb,#d9e9f7)}
    .post:nth-child(3n+2) .app-icon{color:#3f83bc}
    .post:nth-child(3n) .post-art{background:linear-gradient(135deg,#f9f0e5,#f4dfc7)}
    .post:nth-child(3n) .app-icon{color:#c27c31}
    .category{position:absolute;z-index:2;left:12px;top:12px;padding:4px 8px;background:var(--green);color:white;border-radius:3px;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.35px}
    .post-body{padding:15px 16px 16px}
    .meta{font-size:11px;color:#999;margin-bottom:6px}
    .meta span{margin-right:10px}
    .post h2{font-size:17px;line-height:1.4;color:#252525;margin:0 0 8px;font-weight:800}
    .post h2 a:hover{color:var(--green-dark)}
    .post p{margin:0;color:#777;font-size:13px;line-height:1.7}
    .read-more{display:inline-block;margin-top:12px;color:var(--green-dark);font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.4px}
    .read-more:hover{text-decoration:underline}
    .empty{display:none;grid-column:1/-1;background:white;border:1px solid var(--line);padding:28px;text-align:center;border-radius:var(--radius)}
    .sidebar-box{background:#fff;border:1px solid #ededed;border-radius:var(--radius);padding:18px;margin-bottom:20px;box-shadow:var(--shadow)}
    .sidebar-box .section-title{font-size:14px;margin-bottom:14px}
    .about{font-size:13px;color:#777;margin:0}
    .quick-links{list-style:none;margin:0;padding:0}
    .quick-links li{border-bottom:1px solid #f0f0f0}
    .quick-links li:last-child{border-bottom:0}
    .quick-links a{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:9px 0;font-size:13px;color:#666}
    .quick-links a:after{content:"›";font-size:20px;color:var(--green)}
    .quick-links a:hover{color:var(--green-dark)}
    .tag-list{display:flex;flex-wrap:wrap;gap:7px}
    .tag-list button{border:1px solid #e8e8e8;background:#fafafa;color:#777;border-radius:3px;padding:5px 9px;font-size:11px;cursor:pointer}
    .tag-list button:hover,.tag-list button.selected{background:var(--green);border-color:var(--green);color:white}
    .subscribe{display:flex;flex-direction:column;gap:9px}
    .subscribe input{width:100%;border:1px solid #e5e5e5;border-radius:3px;padding:10px;outline-color:var(--green)}
    .subscribe button{border:0;border-radius:3px;padding:10px;background:var(--green);color:#fff;font-weight:800;cursor:pointer}
    .subscribe small{color:#999;font-size:11px}
    .pagination{display:flex;justify-content:center;gap:7px;margin-top:24px}
    .pagination button{border:1px solid #e6e6e6;background:#fff;color:#666;border-radius:3px;padding:8px 12px;cursor:pointer}
    .pagination button.current,.pagination button:hover{background:var(--green);border-color:var(--green);color:#fff}
    .footer{background:#151515;color:#aaa}
    .footer-main{display:grid;grid-template-columns:1.3fr 1fr 1fr;gap:28px;padding-top:30px;padding-bottom:28px}
    .footer h3{margin:0 0 12px;color:#fff;font-size:14px;text-transform:uppercase;letter-spacing:.3px}
    .footer p{font-size:12px;margin:0;color:#aaa}
    .footer a{color:#aaa;font-size:12px}
    .footer a:hover{color:var(--green)}
    .footer-links{display:grid;gap:7px}
    .copyright{border-top:1px solid #2c2c2c;padding:15px 0;font-size:11px}
    .copyright-inner{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}
    .notice{display:none;margin-bottom:15px;padding:10px 12px;background:#edf7e8;color:#3d7926;border:1px solid #d8ebce;border-radius:4px;font-size:12px}
    @media(max-width:800px){
      .page{grid-template-columns:minmax(0,1fr) 250px;gap:18px}
      .posts{gap:13px}
      .post-body{padding:12px}
      .post h2{font-size:15px}
      .nav-links a{padding:0 11px}
    }
    @media(max-width:650px){
      .top-inner{min-height:32px}
      .top-links a:nth-child(n+3){display:none}
      .brand-row{min-height:88px}
      .brand-mark{width:45px;height:45px;font-size:24px;border-radius:11px}
      .brand-name{font-size:24px}
      .tagline{font-size:11px}
      .header-search{width:43px;height:40px;border:0;background:transparent}
      .header-search input{display:none}
      .header-search button{width:43px;flex-basis:43px;border-radius:4px}
      .nav-inner{display:block;position:relative}
      .menu-toggle{display:block;min-height:46px}
      .nav-links{display:none;flex-direction:column;padding:0 0 8px}
      .nav-links.open{display:flex}
      .nav-links a{min-height:41px;padding:0 12px;border-top:1px solid #ffffff20}
      .page{grid-template-columns:1fr;padding-top:19px;gap:22px}
      .posts{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
      .post-art{aspect-ratio:1.2}
      .app-icon{width:58px;height:58px;border-radius:16px;font-size:28px}
      .category{left:8px;top:8px;font-size:9px}
      .post-body{padding:10px}
      .post h2{font-size:14px}
      .post p{font-size:12px}
      .meta{font-size:10px}
      .read-more{font-size:10px}
      .sidebar{display:grid;grid-template-columns:1fr;gap:0}
      .footer-main{grid-template-columns:1fr;gap:22px}
    }
    @media(max-width:360px){
      .posts{grid-template-columns:1fr}
      .post-art{aspect-ratio:16/9}
      .brand-name{font-size:21px}
      .socials{gap:7px}
    }
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{transition:none!important}}
  
.sn-contact{display:flex;justify-content:center;align-items:center;gap:18px;flex-wrap:wrap;padding:22px 12px;margin-top:28px;border-top:1px solid #8885;font-size:14px}
.sn-contact a{display:inline-flex;align-items:center;gap:8px}
.sn-contact img{object-fit:contain}


/* Local requested homepage layout adjustments */
.masthead .brand-row{
  display:flex!important;flex-direction:column!important;
  align-items:center!important;justify-content:center!important;
  gap:14px!important;text-align:center
}
.masthead .brand{
  align-self:center!important;justify-content:center!important;
  margin-inline:auto!important
}
.masthead .brand-name{
  font-size:clamp(2rem,5vw,2.7rem)!important;
  line-height:1.12!important
}
.masthead .tagline span{display:block;line-height:1.65}
.masthead .header-search{width:min(100%,560px)}
.subscribe-telegram{
  display:flex;align-items:center;justify-content:center;gap:8px;
  margin-top:10px;padding:10px;text-decoration:none;
  border:1px solid #ececec;border-radius:7px
}
.subscribe-telegram img{object-fit:contain}

</style>
</head>
<body>
  <header class="masthead" id="home">
    <div class="wrap brand-row">
      <a class="brand" href="./" aria-label="SnappsHub home">
        <div class="brand-mark" aria-hidden="true">S</div>
        <div><p class="brand-name">Snapps<span>Hub</span></p><p class="tagline"><span>Apps, Tools &amp; Useful Resources</span><span>Android TV Apps</span><span>PC &amp; Laptop Apps (Windows)</span></p></div>
      </a>
      <form class="header-search" id="searchForm" role="search">
        <input id="searchInput" type="search" placeholder="Search apps..." aria-label="Search apps">
        <button type="submit" aria-label="Search">⌕</button>
      </form>
    </div>
  </header>

  <nav class="nav-wrap" aria-label="Main navigation">
    <div class="wrap nav-inner">
      <button class="menu-toggle" id="menuToggle" aria-expanded="false" aria-controls="navLinks">☰ <span style="font-size:12px;font-weight:800">MENU</span></button>
      <div class="nav-links" id="navLinks">
        <a class="active" href="#home">Home</a>
        <a href="#latest">Latest Apps</a>
        <a href="#android" data-filter="Android">Android</a>
        <a href="#tools" data-filter="Tools">Tools</a>
        <a href="#games" data-filter="Games">Games</a>
        <a href="#about">About</a>
      </div>
    </div>
  </nav>

  <main class="wrap page">
    <section class="main-column" id="latest">
      <h1 class="section-title"><span>Latest Apps & Tools</span><small id="resultCount">0 apps</small></h1>
      <div class="notice" id="notice" role="status"></div>
      <div class="posts" id="posts">
      </div>
      <div class="empty" id="emptyState">No apps have been added yet.</div>
      <div class="pagination" aria-label="Pagination"><button class="current" type="button">1</button><button type="button" id="showAll">Show all</button></div>
    </section>

    <aside class="sidebar">
      
      <section class="sidebar-box">
        <h2 class="section-title">Browse Categories</h2>
        <ul class="quick-links">
          <li><a href="#android" data-filter="Android">Android Apps</a></li>
          <li><a href="#tools" data-filter="Tools">Tools & Utilities</a></li>
          <li><a href="#games" data-filter="Games">Games</a></li>
          <li><a href="#security" data-filter="Security">Security & Privacy</a></li>
          <li><a href="#productivity" data-filter="Productivity">Productivity</a></li>
        </ul>
      </section>
      <section class="sidebar-box">
        <h2 class="section-title">Popular Tags</h2>
        <div class="tag-list" id="tagList">
          <button type="button" data-filter="Android">Android</button><button type="button" data-filter="Tools">Tools</button><button type="button" data-filter="Games">Games</button><button type="button" data-filter="Security">Security</button><button type="button" data-filter="Productivity">Productivity</button><button type="button" data-filter="Web">Web</button>
        </div>
      </section>
      <section class="sidebar-box">
        <h2 class="section-title">Stay Updated</h2>
        <form class="subscribe" id="subscribeForm">
          <p class="about">Get updates when new apps and guides are added.</p>
          <input type="email" id="emailInput" placeholder="Your email address" aria-label="Your email address" required>
          <button type="submit">Subscribe</button>
          <small>This demo form does not collect or send email addresses.</small>
        </form>
<a class="subscribe-telegram" href="https://t.me/snappshub" target="_blank" rel="noopener noreferrer"><img src="https://telegram.org/img/t_logo.png" alt="" width="20" height="20"> Join SN Apps Hub on Telegram</a>
      </section>
    </aside>
  </main>

  <footer class="footer" id="contact">
    <div class="wrap footer-main">
      <section><h3>SnappsHub</h3><p>Apps, tools, and helpful resources in one place. Update this section with your own site details and links.</p></section>
      <section id="about"><h3>About Us</h3><p>Welcome to SnappsHub — a simple place to discover apps, useful tools, and practical technology guides. Replace this text with your original site description.</p></section><section><h3>Quick Links</h3><div class="footer-links"><a href="#home">Home</a><a href="#about">About Us</a><a href="#privacy" id="privacy">Privacy Policy</a><a href="#contact">Contact</a></div></section>
      <section><h3>Explore</h3><div class="footer-links"><a href="#latest">Latest Apps</a><a href="#android" data-filter="Android">Android Apps</a><a href="#tools" data-filter="Tools">Tools & Utilities</a><a href="#games" data-filter="Games">Games</a></div></section>
    </div>
    <div class="copyright"><div class="wrap copyright-inner"><span>© <span id="year"></span> SnappsHub. All rights reserved.</span><span>Powered by HTML, CSS & JavaScript</span></div></div>
  </footer>

  <script>
    (() => {
      const container = document.getElementById('posts');
      const search = document.getElementById('searchInput');
      const form = document.getElementById('searchForm');
      const empty = document.getElementById('emptyState');
      const count = document.getElementById('resultCount');
      const notice = document.getElementById('notice');
      const nav = document.getElementById('navLinks');
      const toggle = document.getElementById('menuToggle');
      let apps = [];
      let filter = '';

      function safeUrl(value) {
        try {
          const u = new URL(value, location.href);
          return ['https:', 'http:'].includes(u.protocol) ? u.href : '';
        } catch (_) { return ''; }
      }

      function render() {
        container.replaceChildren();
        apps.forEach(app => {
          const name = String(app.name || 'Unnamed app');
          const desc = String(app.description || '');
          const category = String(app.category || 'Apps');
          const url = safeUrl(app.url || '');
          const iconUrl = safeUrl(app.icon || '');

          const article = document.createElement('article');
          article.className = 'post';
          article.dataset.category = category;
          article.dataset.search = [name, desc, category].join(' ').toLowerCase();

          const art = document.createElement('div');
          art.className = 'post-art';
          const badge = document.createElement('span');
          badge.className = 'category';
          badge.textContent = category;
          art.appendChild(badge);

          if (iconUrl) {
            const img = document.createElement('img');
            img.className = 'app-icon';
            img.src = iconUrl;
            img.alt = name + ' icon';
            img.loading = 'lazy';
            art.appendChild(img);
          } else {
            const icon = document.createElement('div');
            icon.className = 'app-icon';
            icon.textContent = name.charAt(0).toUpperCase();
            art.appendChild(icon);
          }

          const body = document.createElement('div');
          body.className = 'post-body';
          const meta = document.createElement('div');
          meta.className = 'meta';
          const m1 = document.createElement('span');
          m1.textContent = 'Apps & Updates';
          const m2 = document.createElement('span');
          m2.textContent = '● ' + category;
          meta.append(m1, m2);

          const heading = document.createElement('h2');
          heading.textContent = name;
          const description = document.createElement('p');
          description.textContent = desc;
          body.append(meta, heading, description);

          if (url) {
   const link = document.createElement('a');
   link.className = 'read-more';
   link.href = 'download.html?name=' + encodeURIComponent(name) +
     '&url=' + encodeURIComponent(url) +
     '&icon=' + encodeURIComponent(iconUrl);
   link.textContent = 'Download →';
   body.appendChild(link);
  }
          article.append(art, body);
          container.appendChild(article);
        });
        applyFilters();
      }

      function applyFilters() {
        const q = (search?.value || '').trim().toLowerCase();
        let visible = 0;
        container.querySelectorAll('.post').forEach(post => {
          const categories = (post.dataset.category || '').toLowerCase().split(/\s+/);
          const show = (post.dataset.search || '').includes(q) &&
            (!filter || categories.some(c => c.includes(filter.toLowerCase())));
          post.hidden = !show;
          if (show) visible++;
        });
        count.textContent = `${visible} ${visible === 1 ? 'app' : 'apps'}`;
        empty.style.display = visible ? 'none' : 'block';
        empty.textContent = apps.length
          ? 'No matching apps found. Try another search.'
          : 'No apps have been added yet.';
        document.querySelectorAll('[data-filter]').forEach(el => {
          el.classList.toggle('selected',
            !!filter && (el.dataset.filter || '').toLowerCase() === filter.toLowerCase());
        });
      }

      form?.addEventListener('submit', e => {
        e.preventDefault();
        applyFilters();
        document.getElementById('latest').scrollIntoView({behavior:'smooth'});
      });
      search?.addEventListener('input', applyFilters);

      document.querySelectorAll('[data-filter]').forEach(el => {
        el.addEventListener('click', e => {
          e.preventDefault();
          filter = el.dataset.filter || '';
          applyFilters();
          document.getElementById('latest').scrollIntoView({behavior:'smooth'});
          nav?.classList.remove('open');
          toggle?.setAttribute('aria-expanded', 'false');
        });
      });

      toggle?.addEventListener('click', () => {
        const open = nav.classList.toggle('open');
        toggle.setAttribute('aria-expanded', String(open));
      });

      document.getElementById('showAll')?.addEventListener('click', () => {
        filter = '';
        if (search) search.value = '';
        applyFilters();
      });

      document.getElementById('subscribeForm')?.addEventListener('submit', e => {
        e.preventDefault();
        notice.textContent = 'This is a front-end demo only. Connect a mailing-list service to enable subscriptions.';
        notice.style.display = 'block';
        document.getElementById('emailInput').value = '';
      });

      const year = document.getElementById('year');
      if (year) year.textContent = new Date().getFullYear();

      fetch('./apps.json', {cache:'no-store'})
        .then(r => { if (!r.ok) throw new Error('apps.json load failed'); return r.json(); })
        .then(data => { apps = Array.isArray(data) ? data : []; render(); })
        .catch(err => {
          console.error(err);
          apps = [];
          render();
          empty.textContent = 'Apps could not be loaded right now.';
        });
    })();
  </script>

